# Copy to .env.local (Next.js) and .env (Prisma CLI) and fill in real values.
# Never commit real secrets.

# PostgreSQL (Neon or Supabase in production)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/forge?schema=public"

# Public site URL (used for canonical URLs, sitemap, Stripe redirects, emails)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth.js — generate with: npx auth secret
AUTH_SECRET="replace-me-with-a-long-random-string"
AUTH_TRUST_HOST=true

# Stripe (test mode keys during development)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Resend (transactional email). Leave empty to log emails to the console.
RESEND_API_KEY=""
EMAIL_FROM="FORGE <no-reply@forge.example>"

# Cloudinary (media)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
