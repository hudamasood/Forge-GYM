// FORGE — database schema (spec Part B2).
// The commercial model is object-based: six Access Objects, each with its own
// single-object plan, plus one ALL_ACCESS plan that unlocks every object.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  TRAINER
  ADMIN
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum PlanType {
  SINGLE_OBJECT
  ALL_ACCESS
}

enum MembershipStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

enum ProductCategory {
  SUPPLEMENTS
  MERCHANDISE
  EQUIPMENT
  DIGITAL
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  passwordHash    String?
  name            String
  role            Role         @default(MEMBER)
  phone           String?
  avatarUrl       String?
  emailVerifiedAt DateTime?
  stripeCustomerId String?     @unique
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  trainer             Trainer?
  memberships         Membership[]
  bookings            Booking[]
  orders              Order[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AccessObject {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  tagline      String   @default("")
  description  String
  heroImageUrl String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  space    Space?
  classes  Class[]
  plans    MembershipPlan[]
  trainers Trainer[]
}

// Physical facility, kept separate from the commercial AccessObject so the two
// concepts can change independently.
model Space {
  id             String   @id @default(cuid())
  accessObjectId String   @unique
  equipmentList  Json
  operatingHours Json
  galleryImages  String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  accessObject AccessObject @relation(fields: [accessObjectId], references: [id], onDelete: Cascade)
  schedules    Schedule[]
}

model Trainer {
  id                    String   @id @default(cuid())
  userId                String?  @unique
  name                  String
  slug                  String   @unique
  bio                   String
  specialty             String
  certifications        String[]
  yearsExperience       Int
  primaryAccessObjectId String
  photoUrl              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  primaryAccessObject AccessObject @relation(fields: [primaryAccessObjectId], references: [id])
  schedules           Schedule[]
}

model Class {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique
  accessObjectId  String
  description     String
  benefits        String[]
  difficulty      Difficulty
  durationMinutes Int
  estCalories     Int
  defaultCapacity Int
  imageUrl        String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  accessObject AccessObject @relation(fields: [accessObjectId], references: [id])
  schedules    Schedule[]

  @@index([accessObjectId])
}

model Schedule {
  id               String   @id @default(cuid())
  classId          String
  trainerId        String
  spaceId          String
  startTime        DateTime
  endTime          DateTime
  capacityOverride Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  class    Class     @relation(fields: [classId], references: [id])
  trainer  Trainer   @relation(fields: [trainerId], references: [id])
  space    Space     @relation(fields: [spaceId], references: [id])
  bookings Booking[]

  @@index([startTime])
  @@index([trainerId, startTime])
  @@index([spaceId, startTime])
}

model Booking {
  id          String        @id @default(cuid())
  userId      String
  scheduleId  String
  status      BookingStatus @default(CONFIRMED)
  bookedAt    DateTime      @default(now())
  cancelledAt DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  // The database itself rejects a double-booking, even under a race.
  @@unique([scheduleId, userId])
  @@index([userId])
}

model MembershipPlan {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  type                 PlanType
  accessObjectId       String?
  priceMonthly         Int // cents, USD
  priceAnnual          Int // cents, USD
  stripePriceIdMonthly String?
  stripePriceIdAnnual  String?
  benefits             Json
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  accessObject AccessObject? @relation(fields: [accessObjectId], references: [id])
  memberships  Membership[]
}

// Access-object coverage is derived from the plan at query time — never
// duplicated onto this row.
model Membership {
  id                   String           @id @default(cuid())
  userId               String
  planId               String
  stripeSubscriptionId String?          @unique
  status               MembershipStatus @default(INCOMPLETE)
  billingInterval      BillingInterval
  currentPeriodEnd     DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan MembershipPlan @relation(fields: [planId], references: [id])

  @@index([userId, status])
}

model Product {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  category    ProductCategory
  price       Int // cents, USD
  stock       Int             @default(0)
  description String
  images      String[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  orderItems OrderItem[]

  @@index([category])
}

model Order {
  id                    String      @id @default(cuid())
  userId                String
  status                OrderStatus @default(PENDING)
  total                 Int // cents, USD
  stripeCheckoutSessionId String?   @unique
  stripePaymentIntentId String?     @unique
  shippingAddress       Json?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // Restrict: orders are accounting records and must outlive account deletion attempts.
  user  User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items OrderItem[]

  @@index([userId])
}

// Price is snapshotted at purchase so a later price change never rewrites
// historical totals.
model OrderItem {
  id                  String @id @default(cuid())
  orderId             String
  productId           String
  quantity            Int
  unitPriceAtPurchase Int // cents, USD

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

// Stripe webhook idempotency: every processed event id is recorded once.
model ProcessedWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

// Admin audit trail (spec B5).
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([entity, createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}
